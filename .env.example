# Copy this file to .env and fill in the values. Never commit .env.

# Public URL of the site, used for metadata, the sitemap and email logo links.
NEXT_PUBLIC_URL=
# Resend API key, used to send the contact form emails.
RESEND_API_KEY=
# Sender address for both emails (the notification and the auto-reply). Must be on a domain verified in Resend.
CONTACT_EMAIL_ADDRESS=
# Your inbox: receives contact form messages, and visitors' replies to the auto-reply.
PERSONAL_EMAIL_ADDRESS=
# Upstash Redis REST credentials, used for contact form rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cloudflare Turnstile keys. For local development, use Cloudflare's test keys:
# site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=